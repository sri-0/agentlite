# Server. Locally clients reach it through the dev gateway on :8000
# (~/code/agentlite-infra: make gateway), which signs a dev user in and forwards
# here with their token.
PORT=8010
HOST=0.0.0.0
LOG_LEVEL=info
LOG_JSON=false
# The largest request body accepted, in MiB (the pass-through reads one whole).
MAX_BODY_MB=32
# CORS origins; * allows any.
ALLOWED_ORIGINS=http://localhost:3000
# The agent socket's settings (WS_*): the pages a browser may open it from.
WS_ALLOWED_ORIGINS=http://localhost:3000
# This server as clients reach it, through any gateway: the base of the URLs
# /.well-known/opencode hands out.
APP_URL=http://localhost:8000
CONFIG_DIR=config/default
# A caller's headers never passed on to an upstream (the MCP proxy, the model
# pass-through); this is the default.
TRANSPORT_SENSITIVE_HEADERS=Authorization,Cookie,X-Api-Key,X-Forwarded-Client-Cert
# How long a provider, MCP server or tool may take to send its response headers.
TRANSPORT_RESPONSE_HEADER_TIMEOUT=5m

# Valkey (sessions, run logs, queues)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB_RUNS=1       # thread event logs, run records, leases, queues
REDIS_DB_SESSIONS=2   # adk sessions (agent state and history per thread)
REDIS_DB_HITL=3       # interrupt records and decisions

# OpenSearch (threads, messages, memories, …). Every call carries the user's
# or the thread's Keycloak token, and document-level security limits it to the
# token's control sets (docs/AUTH.md); the server has no OpenSearch password.
# make indices, make backfill and make security use the internal admin user
# (OPENSEARCH_USERNAME/OPENSEARCH_PASSWORD, defaulting to the local stack's
# admin / Agentlite-Dev-Admin-2026); never give them to the server.
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_INDEX_PREFIX=user_ai_   # starts every index name; make indices uses it too

# Auth (docs/AUTH.md): Keycloak, realm agentlite (~/code/agentlite-infra, :8180). Every
# request but /health needs an access token whose aud includes OIDC_AUDIENCE;
# prod's gateway attaches it, locally agentlite-infra's dev gateway does.
OIDC_ISSUER_URL=http://localhost:8180/realms/agentlite
# The signing keys, when the issuer's own URLs are not reachable from here (in
# a container: http://keycloak:8080/realms/agentlite/protocol/openid-connect/certs).
# Empty: from the issuer's discovery document.
OIDC_JWKS_URL=
OIDC_AUDIENCE=agentlite
# The token claim that lists the user's control sets.
OIDC_CONTROLSET_CLAIM=controlset_ids
# agentlite's own confidential client: exchanges the user's token (standard
# token exchange) for a refresh token in the user's session, which a thread's
# runs use after the user's token expires. Development secret. OIDC_TOKEN_URL
# (empty: the issuer's, from discovery) can point at an STS instead.
OIDC_CLIENT_ID=agentlite
OIDC_CLIENT_SECRET=agentlite-dev-secret
OIDC_TOKEN_URL=
# How long the issuer's userinfo claims are kept per user (Verifier.UserInfo).
OIDC_USERINFO_TTL=5m
# Every POST names its control set in this header: one of the user's, which the
# documents the request creates get. POST routes that need none, by path or
# route pattern, comma-separated (e.g. /v1/chat/completions,/mcp/:id for
# opencode clients); empty: none.
AUTH_CONTROLSET_HEADER=X-Control-Set
AUTH_CONTROLSET_EXEMPT_PATHS=
# Thread tokens: the header of the exchange request that carries the thread's
# control set (for an STS that narrows the token; Keycloak ignores it), how
# long before its expiry an access token is renewed, and the refresh lifetime a
# kept token needs for a run to use it rather than mint again.
STS_CONTROLSET_HEADER=X-Control-Set
STS_EARLY_EXPIRY=30s
STS_MIN_LIFE=5m

# Providers (referenced from config/default/models.yaml)
LITELLM_BASE_URL=http://localhost:4000/v1
LITELLM_API_KEY=
VLLM_BASE_URL=http://localhost:8001/v1
VLLM_API_KEY=
OPENROUTER_API_KEY=
# Development only; leave empty (unset) in production, where the provider is skipped.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Artefact bodies and skill files in S3 (MinIO in ~/code/agentlite-infra); their records are
# in OpenSearch. Required.
S3_ENDPOINT=localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=agentlite
S3_USE_SSL=false

# MCP servers (referenced from mcp connectors in config/default/connectors.yaml)
OPEN_SLIDE_MCP_URL=http://localhost:8090/mcp

# Tracing: export spans over OTLP/HTTP (Jaeger UI at http://localhost:16686); leave empty to disable
OTEL_EXPORTER_OTLP_ENDPOINT=

# Model cards (a checkout of github.com/sri-0/model-cards): offline context
# that enriches the model list. Empty: no cards.
MODEL_CARDS_DIR=
