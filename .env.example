# Server
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=info
LOG_JSON=false
ALLOWED_ORIGINS=http://localhost:3000
CONFIG_DIR=config/default

# Valkey (sessions, run logs, queues)
REDIS_HOST=localhost
REDIS_PORT=6379

# OpenSearch (threads, messages, memories)
OPENSEARCH_URL=http://localhost:9200

# Providers (referenced from config/default/models.yaml)
LITELLM_BASE_URL=http://localhost:4000/v1
LITELLM_API_KEY=
VLLM_BASE_URL=http://localhost:8001/v1
VLLM_API_KEY=
OPENROUTER_API_KEY=
PROXY_PROVIDER=litellm
